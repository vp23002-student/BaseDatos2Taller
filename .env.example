# Copiar a .env (los scripts lo hacen automáticamente si no existe).
# Credenciales SOLO para entorno de laboratorio/demostración.

# Administrador del servidor CouchDB (lo usa el backend en Rust)
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin_taller_2026
COUCHDB_DB=taller

# Usuarios de la aplicación (se crean en CouchDB con su rol: RBAC)
TALLER_ADMIN_USER=jefe
TALLER_ADMIN_PASS=jefe2026
MECANICO1_USER=mecanico1
MECANICO1_PASS=taller2026
MECANICO2_USER=mecanico2
MECANICO2_PASS=taller2026

# Cargar datos sintéticos de demostración al arrancar (true/false)
SEMBRAR_DEMO=true
# Datos que se cargan al arrancar con la base vacía:
#   semilla_demo.json -> ~100 documentos, ideal para la exposición (carga en segundos)
#   semilla.json      -> 120 clientes y ~190 órdenes, para los experimentos
ARCHIVO_SEMILLA=semilla_demo.json
PREFIJO_WHATSAPP=503

# Monolito de referencia (PostgreSQL) para el experimento comparativo
POSTGRES_USER=taller
POSTGRES_PASSWORD=taller_pg_2026
POSTGRES_DB=taller
